# Telemetry Service Deployment Configuration

# Update these values before running deploy.sh

# Build type: 'local' (build on current platform) or 'cross' (cross-compile for ARM)
# Note: Cross-compile requires arm-linux-gnueabihf-gcc installed
export BUILD_TYPE=local

# Raspberry Pi SSH credentials
export PI_USER=pi
export PI_HOST=raspberrypi.local

# Remote deployment path
export PI_PATH=/opt/telemetry-service

# Systemd service name
export SERVICE_NAME=telemetry-service

# Note: If BUILD_TYPE=local, the binary will be built on the current machine
# and deployed. This works for building on the Pi directly.
# For cross-compilation from x86 to ARM, install: sudo apt install gcc-arm-linux-gnueabihf
